   "source": [
    "from sympy import *\n",
    "from sympy.abc import *\n",
    "from sympy.stats import *\n",
    "s = Symbol(\"s\", positive=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "28776401-d083-4ff3-ab0c-2bb42102533e",
   "metadata": {},
   "outputs": [],
   "source": [
    "D1 = Normal(\"g1\", 0, s)\n",
    "D2 = Normal(\"g2\", 0, s)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 83,
   "id": "b17942ff-b127-4526-ab03-8717367a8bbb",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\frac{e^{- \\frac{x^{2}}{4 s^{2}}}}{2 \\sqrt{\\pi} s}$"
      ],
      "text/plain": [
       "exp(-x**2/(4*s**2))/(2*sqrt(pi)*s)"
      ]
     },
     "execution_count": 83,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "simplify(density(D1+D2)(x))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 84,
   "id": "9b56afe3-95b4-4786-854e-dfcdbfab2acb",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\frac{\\sqrt{2} e^{- \\frac{x^{2}}{2 s^{2}}}}{2 \\sqrt{\\pi} s}$"
      ],
      "text/plain": [
       "sqrt(2)*exp(-x**2/(2*s**2))/(2*sqrt(pi)*s)"
      ]
     },
     "execution_count": 84,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "simplify(density(D1)(x))"
   ]
